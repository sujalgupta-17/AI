from collections import deque

def neighbours(state):
    i = state.index(0)
    moves = []
    for d in (-3, 3, -1, 1):
        j = i + d
        if 0 <= j < 9 and not (i % 3 == 0 and d == -1) and not (i % 3 == 2 and d == 1):
            s = list(state)
            s[i], s[j] = s[j], s[i]
            moves.append(tuple(s))
    return moves

def bfs(start, goal):
    q = deque([(start, [start])])
    visited = {start}

    while q:
        state, path = q.popleft()
        if state == goal:
            return path
        for n in neighbours(state):
            if n not in visited:
                visited.add(n)
                q.append((n, path + [n]))

