# Linear Regression using scikit-learn

import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression

# Load dataset
data = pd.read_csv("student_marks.csv")

# Feature (X must be a 2D array / DataFrame) and Target (y)
X = data[["Hours"]]
y = data["Marks"]

# Train-Test split
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.3, random_state=1
)

# Train Linear Regression model
model = LinearRegression()
model.fit(X_train, y_train)

# Model evaluation (R^2 score formatted as percentage)
print("\nTraining Accuracy:", round(model.score(X_train, y_train) * 100, 2))
print("Testing Accuracy:", round(model.score(X_test, y_test) * 100, 2))
