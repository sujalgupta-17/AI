import heapq

graph = {
    'Arad': [('Sibiu', 140)],
    'Sibiu': [('Arad', 140), ('Rimnicu Vilcea', 80)],
    'Rimnicu Vilcea': [('Sibiu', 80), ('Pitesti', 97)],
    'Pitesti': [('Rimnicu Vilcea', 97), ('Bucharest', 101)],
    'Bucharest': []
}

heuristic = {
    'Arad': 366,
    'Sibiu': 253,
    'Rimnicu Vilcea': 193,
    'Pitesti': 100,
    'Bucharest': 0
}

def astar(start, goal):
    queue = []
    heapq.heappush(queue, (heuristic[start], 0, start, [start]))
    visited = set()

    while queue:
        f_cost, g_cost, city, path = heapq.heappop(queue)

        if city == goal:
            return path, g_cost

        if city not in visited:
            visited.add(city)

            for neighbor, distance in graph[city]:
                if neighbor not in visited:
                    new_g = g_cost + distance
                    new_f = new_g + heuristic[neighbor]
                    heapq.heappush(queue, (new_f, new_g, neighbor, path + [neighbor]))

    return None, None

path, cost = astar("Arad", "Bucharest")

print("Shortest Path using A* search:")
print("Path:", " -> ".join(path))
print("Total Cost:", cost)
