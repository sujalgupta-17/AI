import heapq

start = [
    [1, 2, 3],
    [4, 0, 6],
    [7, 5, 8]
]

goal = [
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 0]
]

def heuristic(state):
    distance = 0
    for i in range(3):
        for j in range(3):
            value = state[i][j]
            if value != 0:
                goal_row = (value - 1) // 3
                goal_col = (value - 1) % 3
                distance += abs(i - goal_row) + abs(j - goal_col)
    return distance

def blank(state):
    for i in range(3):
        for j in range(3):
            if state[i][j] == 0:
                return i, j

def greedy(start, goal):
    queue = []
    visited = []
    heapq.heappush(queue, (heuristic(start), start, [start]))

    while queue:
        h, state, path = heapq.heappop(queue)

        print(f"Heuristic = {h}")
        for row in state:
            print(row)
        print()

        if state == goal:
            return path

        if state not in visited:
            visited.append(state)

        x, y = blank(state)
        moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]

        for dx, dy in moves:
            nx = x + dx
            ny = y + dy
            if 0 <= nx < 3 and 0 <= ny < 3:
                new = [row[:] for row in state]
                new[x][y], new[nx][ny] = new[nx][ny], new[x][y]
                if new not in visited:
                    heapq.heappush(queue, (heuristic(new), new, path + [new]))

solution = greedy(start, goal)

print("Solution:\n")
move = 0
for state in solution:
    print(f"Move = {move}")
    for row in state:
        print(row)
    print()
    move += 1

print("Total Moves =", len(solution) - 1)
